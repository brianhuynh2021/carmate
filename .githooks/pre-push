#!/bin/sh
# CarMate pre-push guard
# Blocks direct pushes to main from local.
# Only allowed through the official release process (ALLOW_MAIN_RELEASE=1).

REMOTE_REF_PREFIX="refs/heads/"
PROTECTED="main"
PORT=4999

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#$REMOTE_REF_PREFIX}"
  [ "$branch" = "$PROTECTED" ] || continue

  # 1. Hard-block direct pushes unless the allowing environment variable is set
  if [ "$ALLOW_MAIN_RELEASE" != "1" ]; then
    echo ""
    echo "================================================================="
    echo "🛑 [CHẶN LOCAL] LỆNH PUSH LÊN '$PROTECTED' ĐÃ BỊ TỪ CHỐI!"
    echo "================================================================="
    echo "Kỷ luật Git CarMate (AGENTS.md):"
    echo "  Tuyệt đối KHÔNG push trực tiếp lên '$PROTECTED'."
    echo ""
    echo "👉 Hãy làm việc và push lên nhánh: dev"
    echo "     git checkout dev"
    echo "     git push origin dev"
    echo ""
    echo "👉 Khi nào đã test xong trên 'dev' và muốn release lên production:"
    echo "     npm run release:main"
    echo "================================================================="
    echo ""
    exit 1
  fi

  echo "[pre-push] 🚀 Chuẩn bị release lên '$PROTECTED' — Đang chạy kiểm thử E2E..."

  ROOT=$(git rev-parse --show-toplevel)
  cd "$ROOT" || exit 1

  if lsof -ti:$PORT >/dev/null 2>&1; then
    echo "[pre-push] Cổng $PORT đang bận. Giải phóng rồi thử lại."
    exit 1
  fi

  LOG=$(mktemp)
  NODE_ENV=test PORT=$PORT \
    JWT_SECRET=prepush_local_secret_not_for_production \
    CARMATE_ADMIN_PASSCODE=admin123 \
    node apps/api/src/index.js > "$LOG" 2>&1 &
  SERVER_PID=$!

  # Wait for the server to be ready (up to 30s)
  ready=0
  i=1
  while [ $i -le 30 ]; do
    if curl -sf "http://localhost:$PORT/api/health" >/dev/null 2>&1; then ready=1; break; fi
    sleep 1
    i=$((i + 1))
  done

  if [ $ready -ne 1 ]; then
    echo "[pre-push] Server không khởi động được. Log:"
    tail -20 "$LOG"
    kill $SERVER_PID 2>/dev/null
    rm -f "$LOG"
    exit 1
  fi

  CARMATE_API_URL="http://localhost:$PORT" \
    CARMATE_ADMIN_PASSCODE=admin123 \
    npm test
  STATUS=$?

  kill $SERVER_PID 2>/dev/null
  wait $SERVER_PID 2>/dev/null
  rm -f "$LOG"

  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "[pre-push] ❌ Test THẤT BẠI — huỷ push lên '$PROTECTED'."
    echo "[pre-push]    Sửa lỗi trên 'dev' trước khi release."
    exit 1
  fi

  echo "[pre-push] ✅ Toàn bộ test XANH — Cho phép release lên '$PROTECTED'."
done

exit 0
