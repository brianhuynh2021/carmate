{
  "name": "carmate-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env apps/api/src/index.js",
    "start": "node --env-file-if-exists=.env apps/api/src/index.js",
    "dev:all": "node --env-file-if-exists=.env apps/api/src/index.js",
    "build": "npm run build --workspace=@carmate/web",
    "preview": "npm run preview --workspace=@carmate/web",
    "test": "npm run test:connections && npm run test:commitment && npm run test:driver-activation && npm run test:passenger-flow && npm run test:operator-profiles && npm run test:operator-http && npm run test:operator-presentation",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-local-e2e.js",
    "test:level3": "node --env-file-if-exists=.env scripts/test-level3-engine.mjs",
    "test:compliance": "node --env-file-if-exists=.env scripts/test-cost-sharing-compliance.mjs",
    "test:emergency": "node --env-file-if-exists=.env scripts/test-emergency-call-guard.mjs",
    "test:station": "node --env-file-if-exists=.env scripts/test-station-requests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "cp .githooks/pre-* .git/hooks/ && chmod +x .git/hooks/* && git config core.hooksPath .git/hooks && echo \"\u2705 Git hooks b\u1ea3o v\u1ec7 Local \u0111\u00e3 k\u00edch ho\u1ea1t\"",
    "pr": "gh pr create --base main --head dev --fill || gh pr view --web",
    "backup": "node scripts/backup-db.js",
    "backup:setup": "bash scripts/setup-backup-cron.sh",
    "restore": "node scripts/restore-db.js",
    "db:clear": "node scripts/clear-demo-data.js",
    "db:seed": "node scripts/seed-local-data.js",
    "test:rendezvous": "node --env-file-if-exists=.env scripts/test-spacetime-rendezvous.mjs",
    "test:matrix": "node --env-file-if-exists=.env scripts/test-timeslot-matrix.mjs",
    "test:rescue": "node --env-file-if-exists=.env scripts/test-departure-rescue.mjs",
    "test:assurance": "node --env-file-if-exists=.env scripts/test-assurance-ux.mjs",
    "pentest": "node --env-file-if-exists=.env scripts/pentest-security-audit.js",
    "test:pricing": "node --env-file-if-exists=.env scripts/test-platform-pricing-invariants.mjs",
    "migrate:hubs": "node --env-file-if-exists=.env scripts/migrate-trips-to-hubs.mjs",
    "test:lifecycle": "node --env-file-if-exists=.env scripts/test-trip-lifecycle.mjs",
    "test:intent": "node --env-file-if-exists=.env scripts/test-intent-engine.mjs",
    "test:legacy": "npm run test:e2e && npm run test:level3 && npm run test:compliance && npm run test:emergency && npm run test:station && npm run test:rendezvous && npm run test:matrix && npm run test:rescue && npm run test:assurance && npm run test:pricing && npm run test:lifecycle && npm run test:intent",
    "test:connections": "node scripts/test-connection-flow.mjs",
    "test:commitment": "node scripts/test-booking-commitment.mjs",
    "test:driver-activation": "node scripts/test-driver-activation.mjs",
    "test:passenger-flow": "node scripts/test-passenger-flow.mjs",
    "test:operator-profiles": "node scripts/test-operator-profiles.mjs",
    "test:operator-http": "node scripts/test-operator-http.mjs",
    "test:operator-presentation": "node scripts/test-operator-presentation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
