# ==========================================
# CARMATE PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Runtime environment ('development' or 'production')
NODE_ENV=production

# Port the server listens on
PORT=5173

# Secret key for signing JWT tokens (must be changed in real deployments)
JWT_SECRET=carmate_super_secret_production_key_2026_xyz

# System admin passcode (/admin)
CARMATE_ADMIN_PASSCODE=ChangeMeToSecurePasscode123!

# Zalo ZNS / SMS Gateway configuration (optional, when enabling real SMS sending)
# ZALO_OA_ID=
# ZALO_SECRET_KEY=
# ESMS_API_KEY=
# ESMS_SECRET_KEY=

# Google Gemini AI Agent configuration (free, 0 VND - Stanford + MIT Agentic AI)
# Get a free API key at: https://aistudio.google.com/
# If left empty, the system automatically enables the offline High-Speed Heuristic Reasoning Fallback, no key needed!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram bot configuration for error reports & new trip notifications sent straight to your phone (free, 0 VND)
# Get a free token from @BotFather: https://t.me/BotFather
# Get your Chat ID from @userinfobot: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=


# Admin phone numbers for the UI (optional, comma-separated).
# Only decides whether the admin button is shown/hidden in the UI — every admin endpoint is still
# protected by the server via signed JWT, so this variable grants no real extra privilege.
VITE_ADMIN_PHONE=
