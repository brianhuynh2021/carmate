# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CARMATE PRODUCTION
# ==========================================

# Môi trường chạy ('development' hoặc 'production')
NODE_ENV=production

# Cổng khởi động máy chủ
PORT=5173

# Khóa bí mật ký mã JWT Token (Bắt buộc thay đổi khi chạy thực tế)
JWT_SECRET=carmate_super_secret_production_key_2026_xyz

# Mật mã quản trị viên hệ thống (/admin)
CARMATE_ADMIN_PASSCODE=ChangeMeToSecurePasscode123!

# Cấu hình Zalo ZNS / SMS Gateway (Tùy chọn khi kích hoạt gửi SMS thật)
# ZALO_OA_ID=
# ZALO_SECRET_KEY=
# ESMS_API_KEY=
# ESMS_SECRET_KEY=

# Cấu hình Google Gemini AI Agent (Miễn phí 0đ - Stanford + MIT Agentic AI)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Nếu để trống, hệ thống tự động kích hoạt High-Speed Heuristic Reasoning Fallback offline không cần key!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình Bot Telegram Báo Lỗi & Thông Báo Cuốc Mới Trực Tiếp Về Điện Thoại (0đ Miễn Phí)
# Lấy Token miễn phí từ @BotFather: https://t.me/BotFather
# Lấy Chat ID của bạn từ @userinfobot: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=


# Số điện thoại Quản trị viên cho giao diện (tuỳ chọn, phân tách bằng dấu phẩy).
# Chỉ quyết định hiện/ẩn nút quản trị trên UI — mọi endpoint admin vẫn được
# máy chủ chặn bằng JWT ký, nên biến này không cấp thêm quyền thật.
VITE_ADMIN_PHONE=
