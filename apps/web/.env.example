# ------------------------------------------------------------------------------
# CarMate Web Client (Vite SPA) — Environment Variables Template
# ------------------------------------------------------------------------------
# Branding & domain
VITE_APP_NAME="CarMate"
VITE_APP_URL="https://carmate.vn"
VITE_APP_TAGLINE="Nền tảng đi chung xe gia đình liên tỉnh 0% phí sàn"

# API Engine endpoint (use "/api" when running on the same port 5173, or the full URL when deployed separately)
VITE_API_URL="/api"

# Support channels & real-user community in Vietnam
VITE_HOTLINE_PHONE="0988.234.567"
VITE_ZALO_COMMUNITY_URL="https://zalo.me/g/carmate"

# App features
VITE_ENABLE_PWA=true
