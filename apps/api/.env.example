# ------------------------------------------------------------------------------
# CarMate Core API Engine — Environment Variables Template
# ------------------------------------------------------------------------------
PORT=5173
NODE_ENV=development

# Connection security & CORS whitelist (comma-separated list of domains)
ALLOWED_ORIGINS=https://carmate.vn,https://www.carmate.vn,https://ops.carmate.vn
TRUST_PROXY=false

# Security secrets (REQUIRED when running with NODE_ENV=production, minimum 32 characters)
# JWT_SECRET=your_super_secure_production_jwt_secret_key_32_chars_min
# CARMATE_ADMIN_PASSCODE=your_secure_admin_passcode_min_16_chars

# System admin phone numbers (used by the MIT Invariant Guard: an admin cannot delete themselves).
# Multiple numbers are separated by commas. If left empty, falls back to the default operations number.
# ADMIN_PHONE=0984883750

# OAuth Google Identity — REQUIRED in production to prevent Audience Confusion (checks the ID token's aud).
# Multiple client IDs are separated by commas.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# AI Engine keys (Agentic AI - Stanford Loop + MIT Tools)
# Get one for free at: https://aistudio.google.com/
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# Extended infrastructure integration (Production Scale - Postgres & Redis)
# DATABASE_URL=postgresql://user:password@localhost:5432/carmate?sslmode=disable
# REDIS_URL=redis://localhost:6379

# Community monitoring & operations channels
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LOG_CHAT_ID=
# ZALO_OA_SECRET_KEY=
