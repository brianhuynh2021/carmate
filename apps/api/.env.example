# ------------------------------------------------------------------------------
# CarMate Core API Engine — Environment Variables Template
# ------------------------------------------------------------------------------
PORT=5173
NODE_ENV=development

# Bảo mật kết nối & CORS Whitelist (danh sách domain phân cách bằng dấu phẩy)
ALLOWED_ORIGINS=https://carmate.vn,https://www.carmate.vn,https://ops.carmate.vn
TRUST_PROXY=false

# Khóa bí mật bảo mật (BẮT BUỘC khi chạy NODE_ENV=production, tối thiểu 32 ký tự)
# JWT_SECRET=your_super_secure_production_jwt_secret_key_32_chars_min
# CARMATE_ADMIN_PASSCODE=your_secure_admin_passcode_min_16_chars

# Số điện thoại Quản trị viên hệ thống (dùng cho MIT Invariant Guard: admin không thể tự xoá).
# Nhiều số phân tách bằng dấu phẩy. Nếu bỏ trống sẽ fallback về số vận hành mặc định.
# ADMIN_PHONE=0984883750

# OAuth Google Identity — BẮT BUỘC ở production để chống Audience Confusion (kiểm aud của ID token).
# Nhiều client-id phân tách bằng dấu phẩy.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Khóa AI Engine (Agentic AI - Stanford Loop + MIT Tools)
# Lấy miễn phí tại: https://aistudio.google.com/
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# Tích hợp hạ tầng mở rộng (Production Scale - Postgres & Redis)
# DATABASE_URL=postgresql://user:password@localhost:5432/carmate?sslmode=disable
# REDIS_URL=redis://localhost:6379

# Kênh giám sát & vận hành cộng đồng
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LOG_CHAT_ID=
# ZALO_OA_SECRET_KEY=
